# Local development defaults.
# Uses SQLite and does not create demo data unless DEMO_MODE is enabled.
APP_NAME=AI Recruitment Operations
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./recruitment.db
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DEMO_MODE=false
DEMO_ADMIN_PASSWORD=
COOKIE_SECURE=false
AUTO_CREATE_TABLES=true

# Docker Compose / PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://recruit:recruit_dev_password@postgres:5432/recruitment
# REDIS_URL=redis://redis:6379/0
# DEMO_MODE=true
# DEMO_ADMIN_PASSWORD=change-this-demo-password

# Production must set APP_ENV=production, a non-default SECRET_KEY,
# COOKIE_SECURE=true, DEMO_MODE=false, AUTO_CREATE_TABLES=false,
# and real database credentials. Run `alembic upgrade head` before starting.
POSTGRES_USER=recruit
POSTGRES_PASSWORD=recruit_dev_password
POSTGRES_DB=recruitment

# AI pricing in USD per million tokens. Keys may be provider, model, or provider:model.
AI_PRICE_JSON={"Local Template:rules-plus-template":{"input_per_million":0,"output_per_million":0}}

# Phone webhooks must be signed as:
# HMAC_SHA256("{x-phone-timestamp}.{x-phone-nonce}." + raw_body)
# sent in x-phone-signature as sha256=<hex>.
PHONE_WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# AI providers are configured in the Admin UI/API.
# Never commit real API keys or real candidate data.

# External platform accounts are configured through the Admin UI/API.
# Keep browser storage/session files outside this repository.
# Example PlatformAccount.config values:
# 518 link-resume browser worker:
# {"session_state_path":"C:/secure/recruitops/518-state.json","home_url":"https://www.518.com.tw/","logged_in_selector":"text=會員中心","captcha_selector":"iframe[src*=captcha]","resume_selector":"body","headless":true}
# ChickPT authorized browser worker:
# {"session_state_path":"C:/secure/recruitops/chickpt-state.json","home_url":"https://www.chickpt.com.tw/","logged_in_selector":"text=企業中心","captcha_selector":"iframe[src*=captcha]","resume_selector":"body","headless":true}
# Official API / fixture account:
# {"base_url":"https://official-api.example","api_token":"store-real-token-only-in-env-or-secret-manager","fixture_path":"tests/fixtures/line-platform.json"}
# 518 email polling PlatformAccount.config:
# {"auto_poll_518":true,"inbound_protocol":"imap","host":"imap.example.com","port":993,"ssl":true,"username":"jobs@example.com","password":"store-real-password-in-secret-manager","mailbox":"INBOX","poll_interval_seconds":300}
# Phone PlatformAccount.config:
# {"provider":"twilio-or-telephony-provider","dial_url":"https://phone-provider.example/dial","callback_url":"https://recruit.example/api/webhooks/phone","api_token":"store-real-token-in-secret-manager","timeout_seconds":30}

# Updated ChickPT selector-registry example:
# {"user_data_dir":"C:/secure/recruitops/chickpt-profile","home_url":"https://www.chickpt.com.tw/","post_url":"https://www.chickpt.com.tw/jobs/new","inbox_url":"https://www.chickpt.com.tw/inbox","message_url_template":"https://www.chickpt.com.tw/messages/{conversation_id}","allowed_domains":["www.chickpt.com.tw"],"allowed_actions":["publish","read_messages","send_message","verify_post","verify_message","fetch_resume"],"selector_version":"2026-09","selectors":{"publish":{"version":"2026-09","title":"input[name=title]","content":"textarea[name=content]","submit":"button[type=submit]","success_marker":"text=success"},"inbox":{"version":"2026-09","message_row":"[data-message-row]","message_id_attribute":"data-id","conversation_id_attribute":"data-conversation-id"},"message":{"version":"2026-09","message_box":"textarea[name=message]","send":"button[type=submit]","sent_message":"[data-sent-message]","message_id_attribute":"data-id"}},"logged_in_selector":"text=Dashboard","captcha_selector":"iframe[src*=captcha]","headless":true,"timeout_ms":30000}

# LINE official account with webhook/rate policy:
# {"channel_access_token":"store-real-token-in-secret-manager","channel_secret":"store-real-secret-in-secret-manager","rate_policy":{"quiet_hours":{"start":"22:00","end":"08:00"},"hourly_quota":120,"daily_quota":1000,"candidate_cooldown_seconds":300,"suppress_duplicate_messages":true,"rate_limit_pause_seconds":3600}}

# Facebook page/webhook account with rate policy:
# {"page_id":"1234567890","page_access_token":"store-real-token-in-secret-manager","app_secret":"store-real-secret-in-secret-manager","verify_token":"set-a-random-verify-token","rate_policy":{"hourly_quota":60,"daily_quota":500,"group_cooldown_seconds":600,"suppress_duplicate_messages":true}}

# Retention cleanup safety:
# RETENTION_CLEANUP_INTERVAL_SECONDS=86400
# RETENTION_CLEANUP_BATCH_SIZE=200
# Live DB retention does not purge object storage, email archives, or backups.
# Configure backup/object lifecycle policies separately and document legal holds.

# Calendar/OCR/Redis feature gates.
# These are intentionally disabled until real adapters and acceptance tests exist.
# CALENDAR_AUT_BOOKING_ENABLED=false
# CALENDAR_PROVIDER=google-or-outlook
# Example calendar mock policy in QueueTask payload/API:
# {"provider":"mock","timezone":"Asia/Taipei","workdays":[0,1,2,3,4],"work_start":"09:00","work_end":"18:00","slot_minutes":60,"interview_minutes":60,"required_interviewer_count":2,"interviewer_ids":["hr1","hr2"],"busy":{"hr1":["2027-01-11T10:00+08:00"]}}
# OCR_ENGINE=tesseract
# OCR_LANGUAGES=chi_tra+eng
# OCR_RASTER_DPI=200
# OCR_TIMEOUT_SECONDS=60
# OCR stores PDF source files under data/resumes and queues by document_id only.
# Docker Compose Redis:
# REDIS_PASSWORD=recruit_redis_dev_password
# REDIS_URL=redis://:recruit_redis_dev_password@redis:6379/0
# QUEUE_BACKEND=redis
# Redis Streams mode uses transactional outbox, DB fencing/leases, consumer ACK, pending reclaim, DLQ and replay.
# Phone mock provider example:
# {"provider":"mock","dial_url":"mock://dial","callback_url":"https://recruit.example/api/webhooks/phone"}
